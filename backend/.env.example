# Copy this file to .env and adjust for your environment.
# Never commit your real .env file.

# Path to your trained model, relative to the project root.
MODEL_PATH=models/soil_ph_model.pkl

# Comma-separated list of origins allowed to call this API.
# Add your Vercel URL here once the frontend is deployed, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://agrosense.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
