# Copy this file to .env and adjust for your environment.
# Never commit your real .env file.

# Path to your trained model, relative to the project root.
MODEL_PATH=models/soil_ph_model.pkl

# Comma-separated list of FRONTEND origins allowed to call this API.
# (Not the backend's own domain — e.g. ai.agrosense.my.id does not belong here.)
# Add your deployed frontend URL(s) here once live, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://agrosense.vercel.app,https://agrosense.my.id
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "true" only on resource-constrained shared hosting (AnyMHost/cPanel)
# to force the trained model's n_jobs=-1 estimators to n_jobs=1 at load time
# (in-memory only — the .pkl is never modified; predictions are unaffected).
# passenger_wsgi.py already sets this for you on AnyMHost. Leave unset/false
# for local dev and Docker/Render so FastAPI keeps the model's original
# parallelism.
AGROSENSE_LIMIT_PARALLELISM=false
