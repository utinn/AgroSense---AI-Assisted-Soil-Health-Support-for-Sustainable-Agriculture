# Copy this file to .env (for local dev) and adjust as needed.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Local FastAPI backend (default if this var is unset):
VITE_API_URL=http://localhost:8000

# When you deploy the backend to Render, set this in Vercel's project
# settings (Settings > Environment Variables) to your Render URL instead, e.g.:
# VITE_API_URL=https://agrosense-api.onrender.com
